{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Backend",
            "program": "${workspaceFolder}/function/src/index.js",
            "cwd": "${workspaceFolder}/function",
            "envFile": "${workspaceFolder}/function/.env",
            "runtimeExecutable": "nodemon",
            "restart": true,
            "console": "integratedTerminal",
            "preLaunchTask": "Bật Server Frontend"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Frontend",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/asset",
            "userDataDir": "${workspaceFolder}/.vscode/profile",
            "preLaunchTask": "Bật Server Frontend"
        }
    ],
    "compounds": [
        {
            "name": "Running Debug",
            "configurations": [
                "Debug Backend",
                "Debug Frontend"
            ]
        }
    ]
}