{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Bật Server Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/asset"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "(compiling|Starting|Wait)",
                        "endsPattern": "(compiled|Ready|ready)"
                    }
                }
            ]
        }
    ]
}