PORT=3000
# Chuỗi bí mật để ký JWT — đặt một chuỗi ngẫu nhiên dài và giữ bí mật
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban
JWT_EXPIRES_IN=7d
# Múi giờ dùng để xác định "hôm nay"
TIMEZONE=Asia/Ho_Chi_Minh
# Thư mục chứa file JSON (tương đối so với thư mục function)
DATA_DIR=data
# Origin được phép gọi API, "*" = tất cả; nhiều origin thì phân cách bằng dấu phẩy
CORS_ORIGIN=*
